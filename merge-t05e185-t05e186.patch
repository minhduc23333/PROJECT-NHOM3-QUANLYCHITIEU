+                db.add(ReceiptItem(receipt_id=r.id, item_name=f"Món {i}", quantity=D(1), unit_price=D(30000), line_total=D(30000)))
+            for u in uid.values():
+                db.add(SplitDetail(receipt_id=r.id, user_id=u, item_amount=D(80000), fee_amount=D(0), final_amount=D(80000)))
+            db.add(Debt(receipt_id=r.id, debtor_id=uid["B"], creditor_id=uid["A"], amount=D(80000), status="OPEN"))
+        db.commit()
+    return {"h": h, "gid": gid, "rid": first}
+
+
+def _timed(client, method, url, **kw):
+    t0 = time.perf_counter()
+    res = getattr(client, method)(url, **kw)
+    return res, time.perf_counter() - t0
+
+
+def test_main_endpoints_respond_under_2_seconds(client, loaded):
+    h, gid, rid = loaded["h"]["A"], loaded["gid"], loaded["rid"]
+    endpoints = [
+        ("get", "/api/auth/me"),
+        ("get", "/api/dashboard/summary"),
+        ("get", "/api/groups"),
+        ("get", f"/api/groups/{gid}"),
+        ("get", f"/api/groups/{gid}/receipts"),
+        ("get", f"/api/groups/{gid}/debts"),
+        ("get", f"/api/receipts/{rid}"),
+        ("get", f"/api/receipts/{rid}/selections"),
+        ("get", f"/api/receipts/{rid}/debts"),
+        ("get", "/api/receipts/category-suggestion?merchant_name=Highlands"),
+    ]
+    client.get("/api/auth/me", headers=h)  # khởi động nguội (import, kết nối) không tính vào số đo
+    slow = []
+    for method, url in endpoints:
+        res, dt = _timed(client, method, url, headers=h)
+        assert res.status_code == 200, f"{url}: {res.status_code} {res.text[:200]}"
+        if dt >= LIMIT_SEC:
+            slow.append(f"{url}: {dt:.2f}s")
+    assert not slow, "API chậm hơn 2s: " + "; ".join(slow)
+
+
+def test_login_under_2_seconds(client, loaded):
+    res, dt = _timed(client, "post", "/api/auth/login", json={"email": "a@x.vn", "password": "123456"})
+    assert res.status_code == 200 and dt < LIMIT_SEC, f"login {dt:.2f}s"
diff --git a/backend/tests/test_password_reset.py b/backend/tests/test_password_reset.py
new file mode 100644
index 0000000..4e36093
--- /dev/null
+++ b/backend/tests/test_password_reset.py
@@ -0,0 +1,120 @@
+"""Test quên mật khẩu: không lộ email, token 1 lần dùng / hết hạn, không dùng chéo với token đăng nhập, chống spam."""
+import pytest
+
+from app.core.config import settings
+from app.modules.auth import service
+
+USER = {"full_name": "An Nguyễn", "email": "an@demo.vn", "password": "matkhaucu123"}
+NEW = "matkhaumoi456"
+
+
+@pytest.fixture(autouse=True)
+def _clean_limiter():
+    service.reset_rate_limit()
+    yield
+    service.reset_rate_limit()
+
+
+def _forgot(client, email=USER["email"]):
+    return client.post("/api/auth/forgot-password", json={"email": email})
+
+
+def _token_from(res):
+    link = res.json()["dev_reset_link"]
+    assert "/#/reset-password/" in link
+    return link.split("/#/reset-password/")[1]
+
+
+def _reset(client, token, pw=NEW):
+    return client.post("/api/auth/reset-password", json={"token": token, "new_password": pw})
+
+
+def _login(client, pw):
+    return client.post("/api/auth/login", json={"email": USER["email"], "password": pw})
+
+
+def test_forgot_does_not_reveal_whether_email_exists(client):
+    client.post("/api/auth/register", json=USER)
+    known, unknown = _forgot(client), _forgot(client, "khong-co@demo.vn")
+    assert known.status_code == unknown.status_code == 200
+    assert known.json()["message"] == unknown.json()["message"]
+    assert unknown.json()["dev_reset_link"] is None
+
+
+def test_forgot_rejects_bad_email_format(client):
+    assert _forgot(client, "khong-phai-email").status_code == 422
+
+
+def test_full_flow_new_password_works_old_one_does_not(client):
+    client.post("/api/auth/register", json=USER)
+    token = _token_from(_forgot(client))
+    r = _reset(client, token)
+    assert r.status_code == 200, r.text
+    assert _login(client, NEW).status_code == 200
+    assert _login(client, USER["password"]).status_code == 401
+
+
+def test_reset_token_is_single_use(client):
+    client.post("/api/auth/register", json=USER)
+    token = _token_from(_forgot(client))
+    assert _reset(client, token).status_code == 200
+    again = _reset(client, token, "mot-mat-khau-khac-789")
+    assert again.status_code == 400
+    assert again.json()["error"]["code"] == "RESET_TOKEN_INVALID"
+    assert _login(client, NEW).status_code == 200  # mật khẩu không bị đổi lần 2
+
+
+def test_garbage_and_tampered_tokens_rejected(client):
+    client.post("/api/auth/register", json=USER)
+    token = _token_from(_forgot(client))
+    for bad in ["khong-phai-token-gi-ca", token[:-3] + "abc", token + "x"]:
+        r = _reset(client, bad)
+        assert r.status_code == 400 and r.json()["error"]["code"] == "RESET_TOKEN_INVALID"
+    assert _login(client, USER["password"]).status_code == 200  # mật khẩu cũ còn nguyên
+
+
+def test_expired_token_rejected(client, monkeypatch):
+    client.post("/api/auth/register", json=USER)
+    monkeypatch.setattr(settings, "PASSWORD_RESET_EXPIRE_MINUTES", -1)  # token sinh ra đã hết hạn
+    token = _token_from(_forgot(client))
+    assert _reset(client, token).status_code == 400
+
+
+def test_access_token_cannot_be_used_as_reset_token_and_vice_versa(client):
+    client.post("/api/auth/register", json=USER)
+    access = _login(client, USER["password"]).json()["access_token"]
+    assert _reset(client, access).status_code == 400            # token đăng nhập không đặt lại được mật khẩu
+    reset_token = _token_from(_forgot(client))
+    me = client.get("/api/auth/me", headers={"Authorization": f"Bearer {reset_token}"})
+    assert me.status_code == 401                                 # token đặt lại không đăng nhập được
+
+
+def test_reset_password_validation(client):
+    client.post("/api/auth/register", json=USER)
+    token = _token_from(_forgot(client))
+    assert _reset(client, token, "123").status_code == 422             # quá ngắn
+    assert _reset(client, token, "ế" * 30).status_code == 422          # 90 byte > 72
+    assert _login(client, USER["password"]).status_code == 200          # token vẫn dùng được sau khi bị 422
+    assert _reset(client, token).status_code == 200
+
+
+def test_rate_limit_per_email(client):
+    client.post("/api/auth/register", json=USER)
+    codes = [_forgot(client).status_code for _ in range(service.RATE_LIMIT_MAX + 1)]
+    assert codes[:-1] == [200] * service.RATE_LIMIT_MAX and codes[-1] == 429
+    assert _forgot(client, "nguoi-khac@demo.vn").status_code == 200   # email khác không bị ảnh hưởng
+
+
+def test_email_sent_in_background_and_dev_link_hidden_when_smtp_configured(client, monkeypatch):
+    sent = []
+    monkeypatch.setattr("app.core.mailer.send_email", lambda to, subject, body: sent.append((to, subject, body)) or True)
+    monkeypatch.setattr(settings, "SMTP_HOST", "smtp.example.test")   # giống production: có SMTP
+    client.post("/api/auth/register", json=USER)
+    res = _forgot(client)
+    assert res.status_code == 200 and res.json()["dev_reset_link"] is None   # không lộ liên kết qua API
+    assert len(sent) == 1 and sent[0][0] == USER["email"]
+    assert "/#/reset-password/" in sent[0][2] and "An Nguyễn" in sent[0][2]
+    _forgot(client, "khong-co@demo.vn")
+    assert len(sent) == 1                                              # email lạ: không gửi gì
+    token = sent[0][2].split("/#/reset-password/")[1].split()[0]
+    assert _reset(client, token).status_code == 200
diff --git a/backend/tests/test_split_calc_properties.py b/backend/tests/test_split_calc_properties.py
new file mode 100644
index 0000000..7a1a4cc
--- /dev/null
+++ b/backend/tests/test_split_calc_properties.py
@@ -0,0 +1,76 @@
+"""Regression logic chia tiền (T05E186): kiểm tra TÍNH CHẤT của calc.py trên nhiều bộ dữ liệu ngẫu nhiên có seed cố định.
+
+Bất biến cần luôn đúng:
+  1. Σ final_amount = total_amount (không mất, không thừa một đồng).
+  2. Mọi item_amount / fee_amount >= 0 và là số nguyên đồng (ràng buộc DB).
+  3. Phần lẻ chỉ dồn cho người trả tiền, người khác không bị cộng thêm.
+"""
+import random
+from decimal import Decimal
+
+import pytest
+
+from app.modules.split import calc
+
+D = Decimal
+
+
+def _case(rng):
+    n_users = rng.randint(1, 6)
+    users = list(range(1, n_users + 1))
+    items = {i: D(rng.randint(1, 500) * rng.choice([1, 100, 1000])) for i in range(1, rng.randint(1, 12) + 1)}
+    selectors = {i: rng.sample(users, rng.randint(1, n_users)) for i in items}   # mọi món có ít nhất 1 người chọn
+    base = sum(items.values(), D(0))
+    fee = D(rng.randint(0, int(base) // 4)) if rng.random() < 0.8 else D(0)
+    discount = D(rng.randint(0, min(int(base), 5000))) if rng.random() < 0.5 else D(0)
+    total = base + fee - discount
+    return users, items, selectors, fee, discount, total
+
+
+@pytest.mark.parametrize("seed", range(40))
+def test_invariants_on_random_receipts(seed):
+    rng = random.Random(seed)
+    for _ in range(25):
+        users, items, selectors, fee, discount, total = _case(rng)
+        payer = rng.choice(users)
+        shares = calc.assign_remainder(calc.compute_shares(items, selectors, fee, discount), payer, total)
+        assert sum((s.final_amount for s in shares.values()), D(0)) == total
+        for s in shares.values():
+            assert s.item_amount >= 0 and s.fee_amount >= 0
+            assert s.item_amount == s.item_amount.to_integral_value()
+            assert s.fee_amount == s.fee_amount.to_integral_value()
+
+
+def test_remainder_only_changes_the_payer():
+    items, selectors = {1: D(100000)}, {1: [1, 2, 3]}          # 100.000 / 3 = 33.333,33...
+    before = calc.compute_shares(items, selectors, D(0))
+    after = calc.assign_remainder(before, payer_id=2, total_amount=D(100000))
+    assert after[1].final_amount == before[1].final_amount == D(33333)
+    assert after[3].final_amount == before[3].final_amount == D(33333)
+    assert after[2].final_amount == D(33334)                    # người trả nhận phần lẻ 1 đồng
+
+
+def test_discount_larger_than_fee_never_makes_negative_amounts():
+    items, selectors = {1: D(50000), 2: D(30000)}, {1: [1], 2: [2]}
+    shares = calc.compute_shares(items, selectors, fee_total=D(0), discount_amount=D(641))
+    assert all(s.item_amount >= 0 and s.fee_amount >= 0 for s in shares.values())
+    final = calc.assign_remainder(shares, payer_id=1, total_amount=D(80000) - D(641))
+    assert sum((s.final_amount for s in final.values()), D(0)) == D(79359)
+
+
+def test_unselected_item_goes_to_payer_so_total_still_matches():
+    items, selectors = {1: D(60000), 2: D(40000)}, {1: [1]}     # món 2 chưa ai chọn
+    final = calc.assign_remainder(calc.compute_shares(items, selectors, D(0)), payer_id=2, total_amount=D(100000))
+    assert final[1].final_amount == D(60000) and final[2].final_amount == D(40000)
+
+
+def test_tax_and_service_fee_are_proportional_to_item_share():
+    items, selectors = {1: D(75000), 2: D(25000)}, {1: [1], 2: [2]}
+    shares = calc.compute_shares(items, selectors, fee_total=D(10000))
+    assert shares[1].fee_amount == D(7500) and shares[2].fee_amount == D(2500)
+
+
+def test_total_smaller_than_shares_is_rejected_not_written():
+    shares = calc.compute_shares({1: D(100000)}, {1: [1]}, D(0))
+    with pytest.raises(ValueError):
+        calc.assign_remainder(shares, payer_id=1, total_amount=D(99000))
