       maintainAspectRatio: false,
+      layout: { padding: { top: LIFT_PX + 4 } }, // chừa chỗ để cột nhô lên không bị cắt
+      interaction: { mode: "index", intersect: false }, // rê vào vùng cột (kể cả chỗ trống phía trên) vẫn nhận hover
