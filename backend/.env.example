DATABASE_URL=mysql+pymysql://smartsplit:smartsplit@localhost:3306/smartsplit
# Bắt buộc, >= 32 ký tự. Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=abcd
CORS_ORIGINS=http://localhost:8000

# OCR
OCR_ENGINE=tesseract
OCR_LANG=vie+eng
OCR_TIMEOUT_SEC=30
# Windows: đường dẫn tesseract.exe (Linux/macOS để trống nếu đã có trong PATH)
TESSERACT_CMD=D:/Tesseract-OCR/tesseract.exe
