DATABASE_URL=mysql+pymysql://smartsplit:smartsplit@127.0.0.1:3306/smartsplit
# BẮT BUỘC ĐỔI trước khi chạy thật (APP_ENV=prod báo lỗi nếu < 32 ký tự). Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=doi-gia-tri-nay
CORS_ORIGINS=http://localhost:8000

# dev: tự chạy alembic upgrade head khi DB còn trống (đặt false nếu muốn tự migrate)
AUTO_MIGRATE=true

# OCR
OCR_ENGINE=tesseract
OCR_LANG=vie+eng
OCR_TIMEOUT_SEC=60
# Chỉ cần khi tesseract không nằm trong PATH. Vd Windows: TESSERACT_CMD=D:/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=

# Quên mật khẩu: địa chỉ web mà người dùng mở (để tạo liên kết trong email)
PUBLIC_BASE_URL=http://localhost:8000
PASSWORD_RESET_EXPIRE_MINUTES=30
# Gửi email thật (tùy chọn). Để trống SMTP_HOST thì liên kết đặt lại chỉ hiện trong terminal của backend / giao diện (chế độ dev).
# Gmail: bật xác minh 2 bước rồi tạo "Mật khẩu ứng dụng" (App password) dùng làm SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
